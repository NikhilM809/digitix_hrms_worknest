# Separate PostgreSQL database for Worknest / Digitix Flow.
# Do not point this at the HRMS database (digitix_hrms).
DATABASE_URL="postgresql://hrms:hrms_password@localhost:5432/digitix_flow?schema=public"

# Existing HRMS database (leave, attendance, payslips, KRA). Keep this separate.
HRMS_DATABASE_URL="postgresql://hrms:hrms_password@localhost:5432/digitix_hrms?schema=public"

AUTH_SECRET="replace-with-a-long-random-string"
AUTH_URL="http://localhost:3000"
